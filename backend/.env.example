# Скопируйте в переменные окружения Railway (или экспортируйте локально)
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# PostgreSQL (Railway подставляет автоматически при подключении Postgres-плагина)
DATABASE_URL=postgres://user:password@host:5432/ao_studio
# Вход через Google (Client ID типа «Веб-приложение»)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
