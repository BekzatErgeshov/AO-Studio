# Локально — в backend/.env; на Vercel — в Environment Variables проекта
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.vercel.app
# PostgreSQL (на Vercel подставляет интеграция Neon)
DATABASE_URL=postgres://user:password@host:5432/ao_studio
# Вход через Google (Client ID типа «Веб-приложение»)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
